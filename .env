# Copy this file to ".env" in the same folder as config.py and fill in what
# you need. Everything here has a safe default in config.py, so you only
# need to set the values that differ from the defaults (e.g. your real
# serial port, your Telegram bot token). Requires "pip install python-dotenv"
# (already in requirements.txt) — config.py loads this automatically.

# --- WiFi ingestion server ---
# Must stay 8000 unless you also change SERVER_PORT in
# esp32_probe_csi_combined__1_.ino (which the Golden Rule forbids editing).
WIFI_INGEST_HOST=0.0.0.0
WIFI_INGEST_PORT=8000
WIFI_NODE_ID=corridor_node_1

# --- Piezo serial connection (ae8.ino) ---
# Windows example: COM6   |   Linux example: /dev/ttyUSB0   |   macOS: /dev/cu.usbserial-XXXX
PIEZO_SERIAL_PORT=COM7
PIEZO_BAUD_RATE=115200

# --- Database / logs ---
DB_PATH=./runtime_data/powerstep_system.db
LOG_DIR=./logs
LOG_LEVEL=INFO

# --- Alert thresholds ---
OCCUPANCY_ALERT_THRESHOLD=6
LOW_BATTERY_SOC_THRESHOLD=15
POWER_DROP_RATIO_THRESHOLD=0.8
MISMATCH_STREAK_THRESHOLD=3
ALERT_COOLDOWN_SECONDS=300
PIEZO_OFFLINE_TIMEOUT_SEC=20
WIFI_OFFLINE_TIMEOUT_SEC=30

# --- Telegram alert channel ---
# Create a bot via @BotFather, then message it once and check
# https://api.telegram.org/bot<token>/getUpdates to find your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email alert channel (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Buzzer ---
ENABLE_LOCAL_BUZZER=true
